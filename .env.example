# App Config
VITE_APP_NAME=Pedejá
VITE_APP_URL=

# Supabase public client configuration. The anon key is intentionally public;
# authorization must be enforced by Row Level Security, never by hiding this key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin — use the email configured for the real admin account
VITE_ADMIN_EMAIL=your-admin@email.com

# Development-only emergency fixture. Never enable in preview/production.
VITE_ENABLE_DEV_AUTH=false

# GEMINI_API_KEY is deliberately absent. It belongs in Supabase Edge Function
# secrets and must never use the VITE_ prefix or be shipped to the browser.

